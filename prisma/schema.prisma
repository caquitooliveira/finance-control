generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movimentacao {
  id          Int      @id @default(autoincrement())
  descricao   String
  valor       Float
  tipo        String
  categoria   String
  data        DateTime @default(now())

  userId      String
  user        User @relation(fields: [userId], references: [id])
}

model Meta {
  id          Int      @id @default(autoincrement())
  titulo      String
  valorMeta   Float
  valorAtual  Float
  createdAt   DateTime @default(now())

  userId      String
  user        User @relation(fields: [userId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  movimentacoes Movimentacao[]
  metas         Meta[]
}
